# API version used for Deployment resources
apiVersion: apps/v1

# Resource type
kind: Deployment

# Metadata contains information about the Deployment
metadata:
  # Name of the Deployment
  name: nginx-deployment

# Desired configuration of the Deployment
spec:

  # Number of Nginx Pods we want to run
  replicas: 3

  # Selector tells the Deployment which Pods it manages
  selector:
    matchLabels:
      # This must match the label inside template.metadata.labels
      app: nginx

  # Template defines how the Pods should be created
  template:

    # Labels assigned to every Pod created by this Deployment
    metadata:
      labels:
        # Pod will have the label app=nginx
        # The Service will use this label to find these Pods
        app: nginx

    # Pod specification
    spec:
      containers:

        # Container name
        - name: nginx

          # Nginx Docker image
          image: nginx:latest

          # Port exposed by the Nginx container
          # Nginx listens on port 80
          ports:
            - containerPort: 80

apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
spec:
  replicas: 3

  selector:
