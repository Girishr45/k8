# API version for Service
apiVersion: v1

# Resource type
kind: Service

# Service metadata
metadata:
  # Name of the Service
  name: nginx-nodeport-service

# Service configuration
spec:

  # NodePort exposes the Service on a port of every worker node
  type: NodePort

  # Service uses this selector to find the Nginx Pods
  # This MUST match the Pod label in the Deployment
  selector:
    app: nginx

  # Port configuration
  ports:

    # Communication protocol
    - protocol: TCP

      # Kubernetes Service port
      # Clients inside the cluster can access the Service on port 80
      port: 80

      # Port on the Nginx container
      # Nginx is listening on port 80
      targetPort: 80

      # Port exposed on every Kubernetes worker node
      # We will access the application using NODE-IP:30080
      nodePort: 30080

apiVersion: v1
kind: Service
metadata:
  name: nginx-nodeport-service
spec:
  type: NodePort

  selector:
    app: nginx

  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
      nodePort: 30080


